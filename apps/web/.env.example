# No credentials are necessary for the local editorial preview.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WEBHOOK_SECRET=
# Optional on Vercel: the production URL is detected automatically until a custom domain is chosen.
# For local work, use the local origin; a custom HTTPS origin must have no trailing path.
SITE_URL=http://localhost:3000
# Enable only after real content and external integrations have been verified.
SITE_READY=false
# Optional privacy-friendly analytics. Active only when SITE_READY=true.
CLOUDFLARE_ANALYTICS_TOKEN=
