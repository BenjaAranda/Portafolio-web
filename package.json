{
  "name": "portfolio-profesional",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.8.0"
    },
    "@module-federation/dts-plugin": {
      "adm-zip": "0.6.1"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace @portfolio/web",
    "build": "npm run build --workspace @portfolio/web",
    "start": "npm run start --workspace @portfolio/web",
    "studio": "npm run dev --workspace @portfolio/studio",
    "studio:build": "npm run build --workspace @portfolio/studio",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspace @portfolio/web",
    "test": "npm run test --workspace @portfolio/web",
    "test:e2e": "npm run test:e2e --workspace @portfolio/web"
  }
}
